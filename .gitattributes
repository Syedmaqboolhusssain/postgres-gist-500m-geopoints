# Everything that runs on the Linux server keeps LF line endings, even when the
# repository is checked out on Windows. A CRLF shell script fails on Linux with
# "bash\r: No such file or directory".
* text=auto
*.sh     text eol=lf
*.sql    text eol=lf
*.tftpl  text eol=lf
*.yaml   text eol=lf
*.tf     text eol=lf
.env.example text eol=lf
*.txt    text eol=lf
*.log    text eol=lf
*.pdf    binary
