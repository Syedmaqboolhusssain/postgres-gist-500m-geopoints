# Only needed when running by hand. The Terraform path writes this file for you,
# with generated passwords and the right bind addresses.
#
#   cp .env.example .env
#   nano .env
#
# Docker Compose reads .env from the project directory automatically.
# Do not commit .env.

POSTGRES_PASSWORD=pick-a-long-random-string
PGADMIN_EMAIL=you@example.com
PGADMIN_PASSWORD=pick-another-long-random-string

# Which interface the containers publish on.
#   127.0.0.1  loopback only -- reach it over an SSH tunnel (safe default)
#   0.0.0.0    the machine's public IP too (only behind a narrow firewall)
DB_BIND=127.0.0.1
WEB_BIND=127.0.0.1
